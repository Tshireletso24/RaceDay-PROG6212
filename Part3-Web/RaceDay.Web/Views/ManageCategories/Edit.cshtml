@model CategoryInputModel
@{
    ViewData["Title"] = "Edit category";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="section-title mb-4">Edit category</h1>

                <form asp-action="Edit" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="EventId" />
                    <input type="hidden" asp-for="CategoryId" />

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label"></label>
                        <input asp-for="CategoryName" class="form-control" />
                        <span asp-validation-for="CategoryName" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label asp-for="MinAge" class="form-label"></label>
                            <input asp-for="MinAge" type="number" min="0" max="120" class="form-control" />
                            <span asp-validation-for="MinAge" class="text-danger"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="MaxAge" class="form-label"></label>
                            <input asp-for="MaxAge" type="number" min="0" max="120" class="form-control" />
                            <span asp-validation-for="MaxAge" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save changes</button>
                        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-id="@Model.EventId">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
