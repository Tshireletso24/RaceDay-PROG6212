@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="auth-wrap">
    <div class="auth-card text-center">
        <h1 class="auth-title">Oops &ndash; we hit a hurdle</h1>
        <p class="text-muted">Something went wrong on our side. Please try again, or head back to the start line.</p>
        <a class="btn btn-primary" href="~/">Back to events</a>
        @if (Model?.ShowRequestId == true)
        {
            <p class="small text-muted mt-3 mb-0">Reference: <code>@Model.RequestId</code></p>
        }
    </div>
</div>
