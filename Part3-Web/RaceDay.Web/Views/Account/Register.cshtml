@model RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1 class="auth-title">Join RaceDay</h1>
        <p class="text-muted">Create your account and get on the start line.</p>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label class="form-label d-block">I am a&hellip;</label>
                <div class="btn-group w-100" role="group" aria-label="Account type">
                    <input type="radio" class="btn-check" asp-for="Role" value="Participant" id="roleParticipant" autocomplete="off" />
                    <label class="btn btn-outline-primary" for="roleParticipant">Participant</label>
                    <input type="radio" class="btn-check" asp-for="Role" value="Organiser" id="roleOrganiser" autocomplete="off" />
                    <label class="btn btn-outline-primary" for="roleOrganiser">Organiser</label>
                </div>
            </div>

            <div class="mb-3" id="organiserCodeGroup" style="display:none">
                <label asp-for="OrganiserCode" class="form-label"></label>
                <input asp-for="OrganiserCode" class="form-control" autocomplete="off" />
                <div class="form-text">Organisers need the invite code from the RaceDay team.</div>
                <span asp-validation-for="OrganiserCode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">At least 8 characters.</div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Create account</button>
        </form>

        <p class="mt-3 mb-0 text-center">Already registered? <a asp-action="Login">Log in</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Only Organisers need an invite code, so show the box only for them
        (function () {
            var group = document.getElementById('organiserCodeGroup');
            var organiser = document.getElementById('roleOrganiser');
            function toggle() { group.style.display = organiser.checked ? 'block' : 'none'; }
            document.querySelectorAll('input[name="Role"]').forEach(function (r) {
                r.addEventListener('change', toggle);
            });
            toggle();
        })();
    </script>
}
