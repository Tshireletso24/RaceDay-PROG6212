@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    var role = Context.Session.GetString("Role");
}

<section class="hero mb-4">
    <div class="position-relative">
        <p class="hero-kicker">South Africa's road events platform</p>
        <h1>Every race. <span class="accent">Every runner.</span></h1>
        <p class="lead mb-4">Find your next run, walk or ride, enter in seconds, and track every finish.</p>

        @if (role == null)
        {
            <a class="btn btn-primary btn-lg me-2" asp-controller="Account" asp-action="Register">Get started</a>
            <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
        }
        else if (role == "Organiser")
        {
            <a class="btn btn-primary btn-lg" href="~/Dashboard">Go to your dashboard</a>
        }
        else
        {
            <a class="btn btn-primary btn-lg me-2" href="~/MyEvents">My events</a>
            <a class="btn btn-outline-light btn-lg" href="~/MyResults">My results</a>
        }
    </div>
</section>

<h2 class="section-title mb-3">Find an event</h2>

<form method="get" asp-controller="Home" asp-action="Index" class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="search" class="form-label fw-bold">Search</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Event name or location" />
            </div>
            <div class="col-md-3">
                <label for="eventTypeId" class="form-label fw-bold">Type</label>
                <select id="eventTypeId" name="eventTypeId" class="form-select">
                    <option value="">All types</option>
                    @foreach (var t in Model.EventTypes)
                    {
                        <option value="@t.EventTypeId" selected="@(Model.EventTypeId == t.EventTypeId)">@t.TypeName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="includePast" name="includePast" value="true" checked="@Model.IncludePast" />
                    <label class="form-check-label" for="includePast">Include past events</label>
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Filter</button>
                @if (Model.HasFilters)
                {
                    <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Clear</a>
                }
            </div>
        </div>
    </div>
</form>

@if (Model.LoadError != null)
{
    <div class="alert alert-warning">@Model.LoadError</div>
}
else if (Model.Events.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h4">@(Model.HasFilters ? "No events match your search" : "No upcoming events yet")</h2>
            <p class="text-muted mb-0">@(Model.HasFilters ? "Try a different search or clear the filters." : "Check back soon, new races are added all the time.")</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var e in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(e.ImageUrl))
                    {
                        <div class="event-banner" style="background-image:url('@e.ImageUrl')" role="img" aria-label="@e.Name banner"></div>
                    }
                    else
                    {
                        <div class="event-banner placeholder">@e.EventTypeName.ToUpperInvariant()</div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="small text-muted text-uppercase fw-bold">@e.EventTypeName &middot; @e.DistanceKm.ToString("0.##") km</div>
                        <h2 class="h5 mt-1">@e.Name</h2>
                        <div class="small mb-1">@e.EventDate.ToString("ddd d MMM yyyy") &middot; @e.EventDate.ToString("HH:mm")</div>
                        <div class="small text-muted mb-3">@e.Location</div>
                        <a class="btn btn-primary mt-auto" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">View and enter</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
