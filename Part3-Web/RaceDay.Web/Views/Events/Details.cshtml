@model EventDetailsViewModel
@{
    var e = Model.Event;
    ViewData["Title"] = e.Name;
}

<div class="mb-3"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">&larr; All events</a></div>

<div class="card mb-4">
    @if (!string.IsNullOrEmpty(e.ImageUrl))
    {
        <div class="event-banner" style="height:240px;background-image:url('@e.ImageUrl')" role="img" aria-label="@e.Name banner"></div>
    }
    else
    {
        <div class="event-banner placeholder" style="height:240px">@e.EventTypeName.ToUpperInvariant()</div>
    }
    <div class="card-body">
        <div class="small text-muted text-uppercase fw-bold">@e.EventTypeName &middot; @e.DistanceKm.ToString("0.##") km</div>
        <h1 class="mt-1">@e.Name</h1>
        <div class="row g-3 mt-1">
            <div class="col-md-4"><div class="small text-muted">When</div><div class="fw-bold">@e.EventDate.ToString("dddd d MMMM yyyy")</div><div>@e.EventDate.ToString("HH:mm")</div></div>
            <div class="col-md-4"><div class="small text-muted">Where</div><div class="fw-bold">@e.Location</div></div>
            <div class="col-md-4"><div class="small text-muted">Organiser</div><div class="fw-bold">@e.OrganiserName</div><div class="small text-muted">@e.EnrolmentCount entered so far</div></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(e.Description))
        {
            <hr />
            <p class="mb-0" style="white-space:pre-line">@e.Description</p>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="section-title mb-3">Categories</h2>
        @if (e.Categories.Count == 0)
        {
            <div class="card"><div class="card-body text-muted">The organiser hasn't added categories yet.</div></div>
        }
        else
        {
            @foreach (var c in e.Categories)
            {
                <div class="next-up-item">
                    <div class="fw-bold">@c.CategoryName</div>
                    <div class="small text-muted">@Formatting.AgeRange(c.MinAge, c.MaxAge)</div>
                </div>
            }
        }
    </div>

    <div class="col-lg-6">
        <h2 class="section-title mb-3">Enter this event</h2>
        <div class="card">
            <div class="card-body">
                @if (Model.MyEnrolment != null)
                {
                    <p class="mb-2">You're entered in <strong>@Model.MyEnrolment.CategoryName</strong>.</p>
                    <span class="status-badge status-@Model.MyEnrolment.Status.ToLowerInvariant()">@Model.MyEnrolment.Status</span>
                    <div class="mt-3"><a asp-controller="MyEvents" asp-action="Index">See all my events</a></div>
                }
                else if (!Model.IsLoggedIn)
                {
                    <p>Log in as a Participant to enter this event.</p>
                    <a class="btn btn-primary me-2" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"/Events/Details/{e.EventId}")">Log in</a>
                    <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Register">Create an account</a>
                }
                else if (!Model.IsParticipant)
                {
                    <p class="text-muted mb-0">Organiser accounts can't enter events. Use a Participant account to enter.</p>
                }
                else if (Model.HasPassed)
                {
                    <p class="text-muted mb-0">This event has already taken place.</p>
                }
                else if (e.Categories.Count == 0)
                {
                    <p class="text-muted mb-0">Entries open once the organiser adds categories.</p>
                }
                else
                {
                    <form asp-controller="Events" asp-action="Enter" method="post">
                        <input type="hidden" name="eventId" value="@e.EventId" />
                        <p class="fw-bold mb-2">Choose your category</p>
                        @foreach (var c in e.Categories)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="categoryId" id="cat@(c.CategoryId)" value="@c.CategoryId" required />
                                <label class="form-check-label" for="cat@(c.CategoryId)">
                                    @c.CategoryName <span class="text-muted small">(@Formatting.AgeRange(c.MinAge, c.MaxAge))</span>
                                </label>
                            </div>
                        }
                        <button type="submit" class="btn btn-primary mt-2">Enter event</button>
                        <div class="small text-muted mt-2">Your entry starts as Pending until the organiser confirms it.</div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
