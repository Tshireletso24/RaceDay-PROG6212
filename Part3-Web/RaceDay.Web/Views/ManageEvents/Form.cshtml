@model EventFormViewModel
@{
    var isEdit = Model.EventId.HasValue;
    ViewData["Title"] = isEdit ? "Edit event" : "New event";
    var formAction = isEdit ? "Edit" : "Create";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="section-title mb-4">@(isEdit ? "Edit event" : "Create event")</h1>

                <form asp-action="@formAction" method="post" enctype="multipart/form-data" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="EventId" />
                    <input type="hidden" asp-for="ExistingImageUrl" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventDate" class="form-label"></label>
                            <input asp-for="EventDate" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                            <span asp-validation-for="EventDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DistanceKm" class="form-label"></label>
                            <input asp-for="DistanceKm" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="DistanceKm" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EventTypeId" class="form-label"></label>
                            <select asp-for="EventTypeId" asp-items="(SelectList)ViewBag.EventTypes" class="form-select">
                                <option value="">Choose a type&hellip;</option>
                            </select>
                            <span asp-validation-for="EventTypeId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="BannerFile" class="form-label"></label>
                        @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                        {
                            <img src="@Model.ExistingImageUrl" class="banner-preview mb-2" alt="Current banner" />
                            <div class="form-text mb-2">Choose a new file only if you want to replace this banner.</div>
                        }
                        <input asp-for="BannerFile" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="form-control" />
                        <div class="form-text">JPG, PNG, WebP or GIF, up to 5 MB.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create event")</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
